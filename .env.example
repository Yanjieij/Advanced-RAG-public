# 智谱 API
ZHIPUAI_API_KEY=your_api_key_here
CHROMA_HOST=your_chroma_host
CHROMA_PORT=8000

# 模型配置
LLM_MODEL=glm-4v-flash              # 问答、评估、重排等
INGEST_LLM_MODEL=glm-4-flash        # 摘要生成（ingest 阶段，推荐用快模型）
GENERATE_EVAL_LLM_MODEL=glm-4-flash # 评估数据集生成（批量任务，推荐快模型）
EMBEDDING_MODEL=embedding-3

# 并发控制（按阶段分别设置，不同模型 QPS 不同）
MAX_CONCURRENT=5                     # 通用默认值（兜底）
MAX_CONCURRENT_GENERATE=5            # generate-eval KG 构建（智谱 ~5-10 QPS）
MAX_CONCURRENT_JUDGE=20              # RAGAS Judge 评估（OpenAI ~100+ QPS，可调高）

# RAGAS Judge 配置（评估时的 LLM-as-Judge）
RAGAS_JUDGE_PROVIDER=openai          # zhipu / deepseek / openai（推荐 openai，完整支持 n 参数）
RAGAS_JUDGE_MODEL=gpt-4o-mini        # gpt-4o-mini / deepseek-chat / glm-4 等

# OpenAI API（RAGAS_JUDGE_PROVIDER=openai 时需要）
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# DeepSeek API（RAGAS_JUDGE_PROVIDER=deepseek 时需要）
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 分块参数
CHUNK_SIZE=1024
CHUNK_OVERLAP=128

# 消除 Huggingface Tokenizer 的并行警告（建议开启）
TOKENIZERS_PARALLELISM=false
